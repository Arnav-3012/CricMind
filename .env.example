ANTHROPIC_API_KEY=
# Agent LLM (D-017): any OpenAI-compatible endpoint. OpenRouter example below; Groq is
# https://api.groq.com/openai/v1, Ollama is http://localhost:11434/v1.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=
# Seconds between live calls; 3.5 keeps a 20 requests/minute free tier under its cap. Cached calls skip it.
LLM_MIN_INTERVAL=3.5
